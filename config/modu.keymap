/*
 * Obrey Corne keymap -> MODU-C keymap-only port, 2026-09-11.
 * Source: Obrey/zmk-corne-dongle, config/eyeslash_corne.keymap (saved source snapshot from the previous answer).
 * Target: 22sh22/modu-c-zmk-config; pinned MODU transform bee0bb4b812f63f279eb67e928accc89600b5904.
 * Personal adaptation of the user's keymap, NOT a dongle firmware conversion.
 * No MCU, GPIO, board, wireless-role, or physical-trackball settings are changed.
 * Retain the target repository's existing licenses and attribution files.
 * Build and physical-device testing are still required; this is not a UF2 file.
 * This revision was compared against the saved/transcribed snapshot, not a fresh GitHub fetch.
 * Logical binding positions: 0..66. Positions 51..56 are NON-PHYSICAL placeholders.
 * Unmapped physical positions 0..11 and 66 are disabled (&none) on every layer.
 * Source positions 0..47 retain their bindings through the documented position mapping.
 * No added number row, base-return key, bootloader keys, toggles or one-shot keys.
 */
// Profile: original-only; no layout improvements or new functions added.

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

/* 레이어 번호 정의 */

#define MOUSE_FAST 7
#define MOUSE_SLOW 8
#define Game 9
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* Source mouse-KEY emulation settings are retained.
 * These do NOT change either physical MODU-C trackball listener or its CPI.
 */

&mmv_input_listener {
    input-processors = <&zip_xy_scaler 2 1>;
    mouse_fast {
        layers = <MOUSE_FAST>;
        input-processors = <&zip_xy_scaler 4 1>;
    };

    mouse_teleport {
        layers = <Game>;
        input-processors = <&zip_xy_scaler 20 1>;
    };

    mouse_slow {
        layers = <MOUSE_SLOW>;
        input-processors = <&zip_xy_scaler 1 1>;
    };
};

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};
&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        hm200: hm200 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
            require-prior-idle-ms = <(-1)>;
            flavor = "tap-preferred";
        };

        hm250: hm250 {
            compatible = "zmk,behavior-hold-tap";
            label = "HM250";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <130>;
            require-prior-idle-ms = <(-1)>;
            flavor = "tap-preferred";
        };
    };
    macros {
        spc_spam: spc_spam {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <100>;
            tap-ms = <100>;
            bindings = <&kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp SPACE>;
        };
        mouse_sweep: mouse_sweep {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <200>;
            bindings = <&mmv MOVE_RIGHT &mmv MOVE_LEFT &mmv MOVE_RIGHT &mmv MOVE_LEFT &mmv MOVE_RIGHT &mmv MOVE_LEFT &mmv MOVE_RIGHT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        mouse {
            bindings = <&tog 5>;
            key-positions = <41 62>;
        };
        game {
            bindings = <&tog 9>;
            key-positions = <29 46>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <33 32>;
            layers = <0 1>;
        };

        back_space {
            bindings = <&kp BACKSPACE>;
            key-positions = <31 32>;
            layers = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            display-name = "QWERTY";
            // Layer 0; rows have 12,12,12,12,12,7 logical bindings.
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &mt LG(A) LG(Z)       &kp SLASH             &kp W                 &kp E                 &kp R                 &kp T                 &kp Y                 &kp U                 &kp I                 &kp O                 &kp SEMICOLON         &trans
                &mt LG(X) LG(C)       &hm250 LCTRL A        &hm200 LALT S         &hm200 LEFT_GUI D     &hm200 LSHFT F        &kp G                 &kp H                 &hm200 LSHFT J        &hm200 LEFT_GUI K     &hm200 LALT L         &hm250 LCTRL P        &trans
                &kp LG(V)             &kp Z                 &kp X                 &kp C                 &kp V                 &kp Q                 &kp N                 &kp M                 &kp B                 &kp COMMA             &kp PERIOD            &trans
                &kp A                 &kp W                 &kp S                 &none                 &none                 &none                 &none                 &none                 &none                 &kp D                 &mkp LCLK             &kp SPACE
                &lt 6 ESC             &lt 5 SPACE           &lt 4 CAPSLOCK        &lt 2 ENTER           &lt 1 BACKSPACE       &lt 3 DEL             &none
            >;
        };
        lower_layer {
            display-name = "Num";
            // Layer 1; rows have 12,12,12,12,12,7 logical bindings.
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &trans                &kp LBKT              &kp N7                &kp N8                &kp N9                &kp RBKT              &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &kp APOS              &kp N4                &kp N5                &kp N6                &kp EQUAL             &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &kp GRAVE             &kp N1                &kp N2                &kp N3                &kp BSLH              &trans                &trans                &trans                &kp LBKT              &kp RBKT              &trans
                &trans                &trans                &trans                &none                 &none                 &none                 &none                 &none                 &none                 &trans                &trans                &trans
                &kp DOT               &kp N0                &kp UNDERSCORE        &trans                &trans                &trans                &none
            >;
        };
        Sym {
            display-name = "Sym";
            // Layer 2; rows have 12,12,12,12,12,7 logical bindings.
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &trans                &kp LBRC              &kp AMPS              &kp ASTRK             &kp LPAR              &kp RBRC              &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &kp DQT               &kp DLLR              &kp PRCNT             &kp CARET             &kp PLUS              &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &kp TILDE             &kp EXCL              &kp AT                &kp HASH              &kp PIPE              &trans                &trans                &trans                &kp LBRC              &kp RBRC              &trans
                &trans                &trans                &trans                &none                 &none                 &none                 &none                 &none                 &none                 &trans                &trans                &trans
                &kp RPAR              &trans                &kp MINUS             &trans                &trans                &trans                &none
            >;
        };
        Fun {
            display-name = "Fun";
            // Layer 3; rows have 12,12,12,12,12,7 logical bindings.
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &trans                &kp F12               &kp F7                &kp F8                &kp F9                &kp PSCRN             &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &kp F11               &kp F4                &kp F5                &kp F6                &kp SLCK              &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &kp F10               &kp F1                &kp F2                &kp F3                &kp C_PAUSE           &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &trans                &trans                &none                 &none                 &none                 &none                 &none                 &none                 &trans                &trans                &trans
                &kp K_APP             &kp SPACE             &kp TAB               &trans                &trans                &trans                &none
            >;
        };
        Nav {
            display-name = "Nav";
            // Layer 4; rows have 12,12,12,12,12,7 logical bindings.
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &kp UP                &trans                &trans                &trans
                &trans                &trans                &kp LG(LC(LS(N4)))    &kp LG(LS(N5))        &trans                &trans                &kp TAB               &kp LEFT              &kp DOWN              &kp RIGHT             &kp HOME              &trans
                &trans                &trans                &trans                &trans                &kp LG(LC(LS(N3)))    &trans                &kp INS               &kp PG_UP             &kp PG_DN             &kp END               &kp RALT              &trans
                &trans                &trans                &trans                &none                 &none                 &none                 &none                 &none                 &none                 &trans                &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans                &none
            >;
        };
        Mouse {
            display-name = "Mouse";
            // Layer 5; rows have 12,12,12,12,12,7 logical bindings.
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &trans                &kp LG(MINUS)         &kp LG(EQUAL)         &mo 8                 &kp LG(RBKT)          &kp LG(LBKT)          &kp LG(LBKT)          &kp LG(RBKT)          &mmv MOVE_UP          &kp LG(EQUAL)         &kp LG(MINUS)         &trans
                &trans                &mo 8                 &mkp MCLK             &mkp RCLK             &mkp LCLK             &mo 7                 &kp LG(LBKT)          &mmv MOVE_LEFT        &mmv MOVE_DOWN        &mmv MOVE_RIGHT       &trans                &trans
                &trans                &msc SCRL_RIGHT       &msc SCRL_LEFT        &msc SCRL_UP          &msc SCRL_DOWN        &trans                &kp LG(RBKT)          &msc SCRL_UP          &msc SCRL_DOWN        &msc SCRL_LEFT        &msc SCRL_RIGHT       &trans
                &mmv MOVE_LEFT        &mmv MOVE_UP          &mmv MOVE_DOWN        &none                 &none                 &none                 &none                 &none                 &none                 &mmv MOVE_RIGHT       &mkp LCLK             &trans
                &trans                &trans                &trans                &mkp RCLK             &mkp LCLK             &mkp MCLK             &none
            >;
        };
        Media {
            display-name = "Media";
            // Layer 6; rows have 12,12,12,12,12,7 logical bindings.
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &out OUT_USB          &out OUT_BLE          &out OUT_TOG          &bt BT_CLR            &trans
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &kp C_VOL_DN          &kp C_VOL_UP          &kp K_MUTE            &trans
                &trans                &trans                &trans                &trans                &trans                &trans                &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3          &bt BT_SEL 4          &trans
                &trans                &trans                &trans                &none                 &none                 &none                 &none                 &none                 &none                 &trans                &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans                &none
            >;
        };
        MouseFast {
            display-name = "Fast";
            // Layer 7; rows have 12,12,12,12,12,7 logical bindings.
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &trans                &trans                &none                 &none                 &none                 &none                 &none                 &none                 &trans                &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans                &none
            >;
        };
        MouseSlow {
            display-name = "Slow";
            // Layer 8; rows have 12,12,12,12,12,7 logical bindings.
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &trans                &trans                &none                 &none                 &none                 &none                 &none                 &none                 &trans                &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans                &none
            >;
        };
        game {
            display-name = "Game";
            // Layer 9; rows have 12,12,12,12,12,7 logical bindings.
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &kp TAB               &kp Q                 &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                &kp LCTRL             &kp A                 &kp S                 &kp D                 &kp F                 &trans                &trans                &kp J                 &kp K                 &kp L                 &kp P                 &mouse_sweep
                &kp LEFT_ALT          &trans                &trans                &trans                &trans                &kp B                 &trans                &trans                &trans                &trans                &trans                &spc_spam
                &kp LEFT              &kp UP                &kp DOWN              &none                 &none                 &none                 &none                 &none                 &none                 &kp RIGHT             &mkp RCLK             &trans
                &kp ESC               &kp SPACE             &mkp LCLK             &kp ENTER             &kp BACKSPACE         &kp DELETE            &none
            >;
        };
    };
};
