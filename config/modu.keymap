/*
 * Obrey MODU-C rebuild 4.1 -- based on the uploaded original config ZIP.
 * Original MODU material: Copyright (c) 2026 EKS Inc.; created by Ryu.
 * SPDX-License-Identifier: LicenseRef-EKS-NonCommercial-1.0
 * Unofficial non-commercial modification; preserve LICENSE and NOTICE.md.
 *
 * Base=0, Nav=1, Mouse=2, Game=3, FnMedia=4, Numpad=5, SymbolPad=6.
 * Base: 1+3+5 -> boot the source of those keys; 6+8+0 -> their source.
 * True three-key combos: 80 ms window, 300 ms prior input idle, no long hold.
 * Base typing combos: D+F -> Space, S+D -> Caps Lock.
 * Base left macro column: Tab -> Undo/Select -> Cut/Copy -> Paste.
 * Hold right Backspace for Numpad; hold right Enter for SymbolPad.
 * Hold the far-left thumb Escape for Fn; tap behavior remains Escape.
 * Hold the center-left thumb Space for Mouse; tap behavior remains Space.
 * REQUIRES modules/obrey-combo-boot; this is not a standalone keymap file.
 * No RGB underglow bindings or RGB include are used.
 * Base placeholders 51..56; slot 66 is neutral, not assumed nonexistent.
 * Board/trackball source revisions and metadata are retained from the ZIP.
 * Firmware build and physical tests are separate from source/host tests.
 */

#define L_BASE  0
#define L_NAV   1
#define L_MOUSE 2
#define L_GAME  3
#define L_FN    4
#define L_NUM   5
#define L_SYM   6
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* Only keyboard-generated mouse motion/scroll. Not the physical trackball. */

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        // Real combo-source dispatch. Standard &bootloader alone loses the side.

        boot135: boot135 {
            compatible = "zmk,behavior-obrey-combo-boot";
            #binding-cells = <0>;
            display-name = "Boot left: 1+3+5";
            key-positions = <1 3 5>;
            window-ms = <80>;
            bindings = <&bootloader>;
        };

        boot680: boot680 {
            compatible = "zmk,behavior-obrey-combo-boot";
            #binding-cells = <0>;
            display-name = "Boot right: 6+8+0";
            key-positions = <6 8 10>;
            window-ms = <80>;
            bindings = <&bootloader>;
        };

        hm200: hm200 {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Homerow Mods 200ms";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
            require-prior-idle-ms = <(-1)>;
            flavor = "tap-preferred";
        };

        hm250: hm250 {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Homerow Mods 250ms";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <130>;
            require-prior-idle-ms = <(-1)>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        // Direct three-key combos. The custom behavior restores the actual side.

        combo_boot_135 {
            timeout-ms = <80>;
            require-prior-idle-ms = <300>;
            key-positions = <1 3 5>;
            bindings = <&boot135>;
            layers = <L_BASE>;
        };

        combo_boot_680 {
            timeout-ms = <80>;
            require-prior-idle-ms = <300>;
            key-positions = <6 8 10>;
            bindings = <&boot680>;
            layers = <L_BASE>;
        };

        /* Typing combos are active only on Base. */

        enter {
            timeout-ms = <50>;
            key-positions = <33 32>;
            bindings = <&kp ENTER>;
            layers = <L_BASE>;
        };

        back_space {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp BACKSPACE>;
            layers = <L_BASE>;
        };

        space_df {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp SPACE>;
            layers = <L_BASE>;
        };

        caps_sd {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&kp CAPSLOCK>;
            layers = <L_BASE>;
        };

        /* Intentional pairing-clear gesture: Nav held, then the 1 and 0 number keys together.
         * Clears only the selected Bluetooth profile.
         */

        bluetooth_clear {
            timeout-ms = <50>;
            require-prior-idle-ms = <300>;
            key-positions = <1 10>;
            bindings = <&bt BT_CLR>;
            layers = <L_NAV>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Base: left macro column moved down so Tab sits at the top.

        default_layer {
            display-name = "Base";
            bindings = <
&to L_GAME       &kp N1          &kp N2              &kp N3             &kp N4          &kp N5  &kp N6     &kp N7          &kp N8             &kp N9         &kp N0          &kp MINUS
&kp TAB           &kp SLASH       &kp W               &kp E              &kp R           &kp T   &kp Y      &kp U           &kp I              &kp O          &kp SEMICOLON   &kp EQUAL
&mt LG(A) LG(Z)  &hm250 LCTRL A  &hm200 LALT S       &hm200 LEFT_GUI D  &hm200 LSHFT F  &kp G   &kp H      &hm200 LSHFT J  &hm200 LEFT_GUI K  &hm200 LALT L  &hm250 LCTRL P  &kp APOS
&mt LG(X) LG(C)  &kp Z           &kp X               &kp C              &kp V           &kp Q   &kp N      &kp M           &kp B              &kp COMMA      &kp PERIOD      &kp BSLH
&kp LG(V)        &kp LBKT        &kp RBKT            &none              &none           &none   &none      &none           &none              &kp GRAVE      &mkp LCLK       &mkp RCLK
&lt L_FN ESC      &lt L_MOUSE SPACE  &lt L_NAV CAPSLOCK                                            &lt L_SYM ENTER  &lt L_NUM BACKSPACE  &kp DEL            &trans
            >;
        };

        // Nav; node name lower_layer retained for compatibility with existing repo checks.

        lower_layer {
            display-name = "Nav";
            bindings = <
&to L_BASE  &trans  &trans              &trans          &trans              &trans  &trans   &trans     &trans     &trans     &trans    &trans
&trans      &trans  &trans              &trans          &trans              &trans  &trans   &trans     &kp UP     &trans     &trans    &trans
&trans      &trans  &kp LG(LC(LS(N4)))  &kp LG(LS(N5))  &trans              &trans  &kp TAB  &kp LEFT   &kp DOWN   &kp RIGHT  &kp HOME  &trans
&trans      &trans  &trans              &trans          &kp LG(LC(LS(N3)))  &trans  &kp INS  &kp PG_UP  &kp PG_DN  &kp END    &kp RALT  &trans
&trans      &trans  &trans              &none           &none               &none   &none    &none      &none      &trans     &trans    &trans
&trans      &trans  &trans                                                          &trans   &trans     &trans     &none
            >;
        };

        // Mouse mode; 0 returns to Base. The far-left thumb temporarily activates FnMedia.

        Mouse {
            display-name = "Mouse";
            bindings = <
&to L_BASE  &trans           &trans          &trans        &trans          &trans        &trans        &trans          &trans          &trans           &trans           &trans
&trans      &kp LG(MINUS)    &kp LG(EQUAL)   &none         &kp LG(RBKT)    &kp LG(LBKT)  &kp LG(LBKT)  &kp LG(RBKT)    &mmv MOVE_UP    &kp LG(EQUAL)    &kp LG(MINUS)    &trans
&trans      &none            &mkp MCLK       &mkp RCLK     &mkp LCLK       &none         &kp LG(LBKT)  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans           &trans
&trans      &msc SCRL_RIGHT  &msc SCRL_LEFT  &msc SCRL_UP  &msc SCRL_DOWN  &trans        &kp LG(RBKT)  &msc SCRL_UP    &msc SCRL_DOWN  &msc SCRL_LEFT   &msc SCRL_RIGHT  &trans
&kp TAB     &none            &trans          &none         &none           &none         &none         &none           &none           &mkp MCLK        &mkp LCLK        &mkp RCLK
&mo L_FN    &trans           &trans                                                      &mkp RCLK     &mkp LCLK       &mkp MCLK       &none
            >;
        };

        // Gaming: plain key/button presses; 0 returns to Base. Dot moved from 46 to 35.

        game {
            display-name = "Game";
            bindings = <
&to L_BASE    &kp N1     &kp N2     &kp N3  &kp N4  &kp N5  &kp N6     &kp N7         &kp N8      &kp N9     &kp N0         &kp MINUS
&kp TAB       &kp SLASH  &kp W      &kp E   &kp R   &kp T   &kp Y      &kp U          &kp I       &kp O      &kp SEMICOLON  &kp EQUAL
&kp LCTRL     &kp A      &kp S      &kp D   &kp F   &kp G   &kp H      &kp J          &kp K       &kp L      &kp P          &kp PERIOD
&kp LSHFT     &kp Z      &kp X      &kp C   &kp V   &kp Q   &kp N      &kp M          &kp B       &kp COMMA  &kp UP         &kp BSLH
&kp LEFT_ALT  &mkp RCLK  &trans     &none   &none   &none   &none      &none          &none       &kp LEFT   &kp DOWN       &kp RIGHT
&lt L_FN ESC  &kp SPACE  &mkp LCLK                          &kp ENTER  &kp BACKSPACE  &kp DELETE  &none
            >;
        };

        // Fn + media layer retained. Playback/volume live on the right-center row.

        FnMedia {
            display-name = "FnMedia";
            bindings = <
&kp F11  &kp F1     &kp F2     &kp F3     &kp F4        &kp F5          &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       &kp F12
&trans   &kp GRAVE  &kp PSCRN  &kp SLCK   &kp C_PAUSE   &kp CAPSLOCK    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp K_APP
&trans   &trans     &trans     &trans     &trans        &trans          &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE
&trans   &kp LBKT   &kp RBKT   &mkp MCLK  &msc SCRL_UP  &msc SCRL_DOWN  &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &kp APOS      &trans        &trans
&trans   &trans     &trans     &none      &none         &none           &none         &none         &none         &trans        &trans        &trans
&trans   &trans     &trans                                              &trans        &trans        &trans        &none
            >;
        };

        // Numpad: hold right Backspace. Left hand is a calculator-style 4x4 pad.
        // Uses regular number-row HID codes, so it does not depend on Num Lock state.

        Numpad {
            display-name = "Numpad";
            bindings = <
&kp EQUAL  &kp BSPC  &kp N7  &kp N8      &kp N9     &kp FSLH   &trans  &trans  &trans  &trans  &trans  &trans
&kp DEL    &kp TAB   &kp N4  &kp N5      &kp N6     &kp ASTRK  &trans  &trans  &trans  &trans  &trans  &trans
&kp LPAR   &kp RPAR  &kp N1  &kp N2      &kp N3     &kp MINUS  &trans  &trans  &trans  &trans  &trans  &trans
&kp COMMA  &kp DOT   &kp N0  &kp PERIOD  &kp ENTER  &kp PLUS   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &none   &none   &none   &none      &none     &none   &trans      &trans     &trans
&trans  &trans  &trans                                  &trans  &trans  &trans  &none
            >;
        };

        // SymbolPad: hold Enter. Common symbols are concentrated on the left hand.

        SymbolPad {
            display-name = "SymbolPad";
            bindings = <
&kp EXCL   &kp AT      &kp HASH  &kp DLLR   &kp PRCNT  &kp CARET  &trans  &trans  &trans  &trans  &trans  &trans
&kp AMPS   &kp ASTRK   &kp LPAR  &kp RPAR   &kp MINUS  &kp EQUAL  &trans  &trans  &trans  &trans  &trans  &trans
&kp LBKT   &kp RBKT    &kp LBRC  &kp RBRC   &kp BSLH   &kp PIPE   &trans  &trans  &trans  &trans  &trans  &trans
&kp UNDER  &kp PLUS    &kp SEMI  &kp COLON  &kp SQT    &kp DQT    &trans  &trans  &trans  &trans  &trans  &trans
&kp GRAVE  &kp TILDE   &kp FSLH  &kp QMARK  &kp LT     &kp GT     &none   &none   &none   &trans  &trans  &trans
&trans     &trans       &trans                                    &trans  &trans  &trans  &none
            >;
        };
    };
};
